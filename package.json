    "@giscus/react": "^3.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.4",
    "dayjs": "^1.11.19",
    "lodash.kebabcase": "^4.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
