---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName, postCount: tagPosts.length },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName, postCount } = Astro.props;

/**
 * Below this many posts a tag page is a shell around a single link rather than
 * a topic hub, so it is kept out of the index (and, via the sitemap
 * post-process in astro.config.ts, out of the sitemap too).
 */
const MIN_POSTS_TO_INDEX = 3;

const baseDescription =
  postCount === 1
    ? `The one post on this blog tagged "${tagName}".`
    : `All ${postCount} posts on this blog tagged "${tagName}".`;

// Same duplicate-listing problem as /posts/: without the page number every
// page of a paginated tag serves identical metadata.
const isFirstPage = page.currentPage === 1;

const title = isFirstPage
  ? `Tag: ${tagName} | ${SITE.title}`
  : `Tag: ${tagName} (page ${page.currentPage} of ${page.lastPage}) | ${SITE.title}`;

const description = isFirstPage
  ? baseDescription
  : `${baseDescription} Page ${page.currentPage} of ${page.lastPage}.`;
---

<Layout
  {title}
  {description}
  pageType="collection"
  noindex={postCount < MIN_POSTS_TO_INDEX}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
  <Header />
  <Main
    pageTitle={[`Tag: `, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
