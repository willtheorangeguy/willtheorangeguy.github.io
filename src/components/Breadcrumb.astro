---
import { absoluteUrl, breadcrumbList } from "@/utils/structuredData";

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Captured before the display-label collapsing below, which rewrites entries in
// place and so can no longer be mapped back to real ancestor URLs.
const rawSegments = currentUrlPath.split("/").filter(Boolean);

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const crumbs = currentUrlPath.split("/").slice(1);

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (crumbs[0] === "posts") {
  crumbs.splice(0, 2, `Posts (page ${crumbs[1] || 1})`);
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
if (crumbs[0] === "tags" && !isNaN(Number(crumbs[2]))) {
  crumbs.splice(
    1,
    3,
    `${crumbs[1]} ${Number(crumbs[2]) === 1 ? "" : "(page " + crumbs[2] + ")"}`
  );
}

// The visual trail collapses pagination into one label; the schema mirrors the
// real URL hierarchy instead. The current page carries no `item` URL.
const jsonLd = breadcrumbList([
  { name: "Home", url: absoluteUrl("/") },
  ...rawSegments.map((segment, index) => ({
    name: decodeURIComponent(segment),
    ...(index < rawSegments.length - 1 && {
      url: absoluteUrl(`/${rawSegments.slice(0, index + 1).join("/")}/`),
    }),
  })),
]);
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>

<nav class="mx-auto mt-8 mb-1 w-full max-w-5xl px-4" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href="/" class="opacity-80">Home</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      crumbs.map((breadcrumb, index) =>
        index + 1 === crumbs.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a href={`/${breadcrumb}/`} class="capitalize opacity-70">
              {breadcrumb}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
